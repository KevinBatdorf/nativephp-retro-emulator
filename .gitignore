/vendor/
/node_modules/

# Test ROMs — fetched via scripts/fetch_test_roms.sh, never committed
/tests/roms/

# Prebuilt native libs SHIP with the plugin (hosts don't compile ares) —
# override the global *.so ignore. Refresh via scripts/build_android_libs.sh.
!resources/android/jniLibs/**/*.so
.DS_Store
*.log

# Private local working files — never tracked
.claude/

# Dev-supplied firmware + commercial ROMs — banned from the repo by policy,
# kept local-only for on-device verification
/local/

# Android
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/.idea/
android/*.iml

# iOS / native build output
/build/
.build/
.swiftpm/
