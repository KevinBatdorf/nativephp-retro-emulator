<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- READ_EXTERNAL_STORAGE lets tests load ROM files from device storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="RetroEmulator"
        android:supportsRtl="true">

        <!--
            Phase 4 test harness.  Intent extras:
              ROM_PATH (String, required) — absolute path to a .sfc ROM.
              IPL_PATH (String, optional) — path to the 64-byte ipl.rom.
        -->
        <activity
            android:name=".EmulatorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:screenOrientation="landscape" />

    </application>

</manifest>
